# ══════════════════════════════════════════════════════════════════════════
#  CONSELHO — Variáveis de ambiente
#
#  ⚠️ IMPORTANTE: copie este arquivo para  apps/web/.env.local
#     (o Next.js NÃO lê o .env da raiz do repositório!)
#
#     cp .env.example apps/web/.env.local
#
#  Guia completo de instalação: docs/TUTORIAL.md
#  Como gerar as chaves de API:  docs/GUIA-APIS.md
# ══════════════════════════════════════════════════════════════════════════

# ── OBRIGATÓRIA EM PRODUÇÃO ─────────────────────────────────────────────────
# Chave de criptografia dos dados em repouso (AES-256). Base64 de 32 bytes.
# Gerar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em dev local, se ausente, uma chave fixa de desenvolvimento é usada.
# NUNCA perca esta chave em produção — sem ela os dados ficam ilegíveis.
DATA_ENCRYPTION_KEY=

# ── IA DOS CONSELHEIROS (escolha UM provedor) ───────────────────────────────
# Prioridade automática: OPENAI_API_KEY > GEMINI_API_KEY > ANTHROPIC_API_KEY >
# modo demonstração (respostas fake determinísticas). Force um provedor com
# LLM_PROVIDER. Como obter as chaves: docs/GUIA-APIS.md
#
# OpenAI (default se presente):
OPENAI_API_KEY=
# Modelo da OpenAI (opcional). Default: gpt-5-mini.
# OPENAI_MODEL=gpt-5-mini
#
# Google Gemini:
GEMINI_API_KEY=
# Modelo do Gemini (opcional). Default: gemini-flash-latest — alias que SEMPRE
# aponta para o Flash estável mais novo, com fallback automático de modelo em
# picos de demanda/modelo aposentado. (Lição: o gemini-2.5 foi descontinuado.)
# GEMINI_MODEL=gemini-flash-latest
#
# Anthropic (Claude):
ANTHROPIC_API_KEY=
#
# Forçar um provedor específico (opcional): openai | gemini | anthropic | fake
# LLM_PROVIDER=

# ── TRANSCRIÇÃO AO VIVO (Deepgram) ──────────────────────────────────────────
# Necessária só para a "🎙️ Reunião ao vivo" (microfone real).
# A "▶ Reunião simulada" funciona sem ela.
# Como obter: docs/GUIA-APIS.md → seção Deepgram
DEEPGRAM_API_KEY=

# ── BOT DE REUNIÃO EXTERNA (Recall.ai) ──────────────────────────────────────
# Só para o botão "🤖 Bot entrar na reunião" (ver participantes/tela
# compartilhada de um Google Meet/Zoom/Teams externo) — janela de
# visualização separada, NÃO alimenta a transcrição/board (isso continua
# vindo do microfone/áudio da aba). Painel: https://<região>.recall.ai/dashboard
# (região do workspace, ex.: us-west-2 — a mesma região vale pra API e pro
# painel). RECALL_API_KEY em Developers → API Keys & Secrets → New API Key.
# RECALL_WEBHOOK_SECRET é o "Verification Secret" da mesma página (whsec_...)
# — verifica que webhooks/websockets recebidos são REALMENTE do Recall.ai.
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
# RECALL_API_BASE_URL=https://us-west-2.recall.ai (default — troque pela região do seu workspace)

# ── ÁREA DE CUSTOS (só o dono da plataforma, /admin/costs) ──────────────────
# Custo de infraestrutura da OPERAÇÃO (não é custo do cliente). Cada provedor
# é opcional — sem a chave, o card correspondente aparece como "indisponível"
# sem quebrar o resto do painel.
#
# Anthropic: Admin API key (sk-ant-admin...), DIFERENTE da ANTHROPIC_API_KEY
# acima — gerar em console.anthropic.com → Settings → Admin API Keys.
# ANTHROPIC_ADMIN_API_KEY=
#
# OpenAI: Admin API key, DIFERENTE da OPENAI_API_KEY acima — gerar em
# platform.openai.com/settings/organization/admin-keys. Só relevante se você
# usa OpenAI como LLM_PROVIDER.
# OPENAI_ADMIN_API_KEY=
#
# Deepgram: reusa a DEEPGRAM_API_KEY já configurada acima — nenhuma chave nova.
# DEEPGRAM_PROJECT_ID opcional (default: descobre o primeiro projeto da conta).
# DEEPGRAM_PROJECT_ID=
#
# Recall.ai: reusa RECALL_API_KEY/RECALL_API_BASE_URL já configuradas acima —
# a API deles só devolve MINUTOS de bot, não valor em dólar, então o custo
# aqui é sempre uma ESTIMATIVA (minutos × tarifa). Ajuste a tarifa se seu
# plano contratado divergir do preço de tabela (US$0,50/hora em 2026):
# RECALL_HOURLY_RATE_USD=0.50
#
# Fly.io: NÃO tem API de billing/fatura — isto estima o custo pelas máquinas
# rodando agora (Fly Machines API) × tarifa pública, sem banda/volumes/região.
# FLY_API_TOKEN: `fly tokens create readonly -a <app>` (ou `flyctl auth token`).
# FLY_APP_NAME é auto-injetada pela própria Fly em produção — só precisa
# configurar em dev local, se quiser testar esta tela.
# FLY_API_TOKEN=
# FLY_APP_NAME=conselho-diretor

# ── E-MAIL (recuperação de senha) ───────────────────────────────────────────
# Resend (https://resend.com). Sem RESEND_API_KEY: o link de recuperação só
# é logado no servidor (dev) em vez de enviado por e-mail.
RESEND_API_KEY=
# EMAIL_FROM=Conselho <nao-responda@coevoconstrutora.com.br>

# ── BANCO DE DADOS ──────────────────────────────────────────────────────────
# Sem DATABASE_URL: banco local automático (PGlite em apps/web/.pgdata) — dev.
# Em produção: Postgres com TLS obrigatório (ex.: Neon, Supabase, RDS).
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# ── USUÁRIO DEMO ────────────────────────────────────────────────────────────
# Em dev local (sem DATABASE_URL) o usuário demo@conselho.test/conselho123 é
# criado automaticamente. Em PRODUÇÃO ele NUNCA é criado — crie o seu com:
#   pnpm create-user -- --email voce@empresa.com --nome "Seu Nome" --senha "SenhaForte"
# (ALLOW_DEMO_LOGIN=true força o demo em produção — não use.)
# ALLOW_DEMO_LOGIN=false

# ── WEBSOCKET DO BOARD ──────────────────────────────────────────────────────
# 'port' (default): gateway na porta 3001 — dev local com `pnpm dev`.
# 'attached': WS na MESMA porta do HTTP — produção (requer server.mjs como CMD).
# BOARD_WS_MODE=port
# BOARD_WS_PORT=3001

# ── CALIBRAÇÃO DO BOARD (opcional — defaults sensatos) ──────────────────────
# BOARD_MAX_PER_MINUTE_PER_AGENT=1     # teto de cards/min por conselheiro
# BOARD_MAX_PER_MINUTE_GLOBAL=4        # teto de cards/min do board inteiro
# BOARD_CASE_REVIEW_MS=90000           # revisão periódica do caso (ms)
# BOARD_SEMANTIC_DEDUP_THRESHOLD=0.5   # corte anti-repetição (0..1)
# BOARD_ACTIVE_RETENTION_MS=7200000    # retenção da sessão em memória pós-fim
